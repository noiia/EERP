{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "incremental": true,
    "allowJs": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "env.d.ts", "app", "src", "vitest.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
