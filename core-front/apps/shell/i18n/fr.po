msgid ""
msgstr ""
"Project-Id-Version: eerp-shell 0.0.0\n"
"Language: fr\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Menu"
msgstr "Menu"

msgid "Settings"
msgstr "Paramètres"

msgid "Logout"
msgstr "Déconnexion"

msgid "Signed in as"
msgstr "Connecté en tant que"

msgid "Dashboard"
msgstr "Tableau de bord"

msgid "List"
msgstr "Liste"

msgid "Manage your workspace preferences."
msgstr "Gérez les préférences de votre espace de travail."

msgid "Appearance"
msgstr "Apparence"

msgid "Brand colors and light/dark mode for the whole interface."
msgstr "Couleurs de marque et mode clair/sombre pour toute l'interface."

msgid "Translations"
msgstr "Traductions"

msgid "Workspace default language, plus the translations modules provide."
msgstr "Langue par défaut de l'espace de travail et traductions fournies par les modules."

msgid "Account"
msgstr "Compte"

msgid "Your personal preferences, like the display language."
msgstr "Vos préférences personnelles, comme la langue d'affichage."

msgid "Customize the brand colors used across the interface. Changes apply instantly and are saved on this device."
msgstr "Personnalisez les couleurs de marque utilisées dans l'interface. Les modifications s'appliquent immédiatement et sont enregistrées sur cet appareil."

msgid "Dark mode"
msgstr "Mode sombre"

msgid "Reset to defaults"
msgstr "Réinitialiser les valeurs par défaut"

msgid "Preview"
msgstr "Aperçu"

msgid "Choose the workspace default language and manage the translations installed modules provide."
msgstr "Choisissez la langue par défaut de l'espace de travail et gérez les traductions fournies par les modules installés."

msgid "Default language"
msgstr "Langue par défaut"

msgid "The interface language for every user who has not picked one in Settings → Account."
msgstr "La langue de l'interface pour chaque utilisateur qui n'en a pas choisi une dans Paramètres → Compte."

msgid "Changing the workspace default language requires the settings:i18n:write permission."
msgstr "Modifier la langue par défaut de l'espace de travail nécessite la permission settings:i18n:write."

msgid "English (source)"
msgstr "Anglais (source)"

msgid "Your personal preferences. They follow your account on every device."
msgstr "Vos préférences personnelles. Elles suivent votre compte sur tous vos appareils."

msgid "Display language"
msgstr "Langue d'affichage"

msgid "Workspace default"
msgstr "Défaut de l'espace de travail"

msgid "Languages come from the translations enabled in Settings → Translations. \"Workspace default\" follows whatever the workspace administrator picks."
msgstr "Les langues proviennent des traductions activées dans Paramètres → Traductions. « Défaut de l'espace de travail » suit le choix de l'administrateur de l'espace de travail."

msgid "Your preferences could not be loaded — try reloading the page."
msgstr "Vos préférences n'ont pas pu être chargées — essayez de recharger la page."

msgid "Available translations"
msgstr "Traductions disponibles"

msgid "Discovered from the i18n folder of each module (.po files, one per language). Add a translation to offer it as a display language in Settings → Account."
msgstr "Découvertes dans le dossier i18n de chaque module (fichiers .po, un par langue). Ajoutez une traduction pour la proposer comme langue d'affichage dans Paramètres → Compte."

msgid "No translations found. Modules ship them as i18n/<locale>.po files."
msgstr "Aucune traduction trouvée. Les modules les fournissent sous forme de fichiers i18n/<locale>.po."

msgid "Add"
msgstr "Ajouter"

msgid "Remove"
msgstr "Retirer"

msgid "strings"
msgstr "chaînes"

msgid "from"
msgstr "depuis"

msgid "Export translation files"
msgstr "Exporter les fichiers de traduction"

msgid "Download one .po file per selected module with every translatable string, pre-filled with the existing translations for the target language. Save each file as i18n/<locale>.po inside its module folder and rebuild."
msgstr "Téléchargez un fichier .po par module sélectionné contenant toutes les chaînes traduisibles, prérempli avec les traductions existantes pour la langue cible. Enregistrez chaque fichier sous i18n/<locale>.po dans le dossier de son module puis reconstruisez."

msgid "Modules"
msgstr "Modules"

msgid "Target language"
msgstr "Langue cible"

msgid "Export"
msgstr "Exporter"

msgid "Users"
msgstr "Utilisateurs"

msgid "User accounts and roles of the workspace."
msgstr "Comptes utilisateurs et rôles de l'espace de travail."

msgid "User accounts"
msgstr "Comptes utilisateurs"

msgid "Edit user"
msgstr "Modifier l'utilisateur"

msgid "New user"
msgstr "Nouvel utilisateur"

msgid "Roles"
msgstr "Rôles"

msgid "Edit role"
msgstr "Modifier le rôle"

msgid "New role"
msgstr "Nouveau rôle"

msgid "Email"
msgstr "E-mail"

msgid "Name"
msgstr "Nom"

msgid "Description"
msgstr "Description"

msgid "Created"
msgstr "Créé le"

msgid "No applications are available for your account."
msgstr "Aucune application n'est disponible pour votre compte."

msgid "Reset"
msgstr "Réinitialiser"

msgid "Save"
msgstr "Enregistrer"

msgid "Saving…"
msgstr "Enregistrement…"

msgid "Create"
msgstr "Créer"
