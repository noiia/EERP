{
  "name": "eerp-front",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "pnpm --filter @eerp/shell dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @eerp/shell start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^26",
    "eslint": "^10",
    "globals": "^17",
    "prettier": "^3",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vitest": "^4"
  }
}